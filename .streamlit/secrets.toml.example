# 複製為 .streamlit/secrets.toml（勿提交到 Git）
# 本機：在專案根目錄建立 .streamlit/secrets.toml 並填入下方內容
# 雲端：Streamlit Cloud → App → Settings → Secrets

[spotify]
client_id = "從 developer.spotify.com 複製的 Client ID"
client_secret = "從同一頁 View client secret 複製"

# 選填：YouTube 下載 cookies（雲端 403 時，貼 cookies.txt 全文）
# [youtube]
# cookies_txt = """
# # Netscape HTTP Cookie File
# .youtube.com	TRUE	/	TRUE	0	...
# """
